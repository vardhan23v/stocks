<%-- All recommendations with a type filter, plus the rule table (RecommendationController). --%>
<%@ page pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/common/taglibs.jspf" %>
<ss:page title="Recommendations">
    <ss:messages/>

    <div class="ss-page-head">
        <div>
            <p class="ss-eyebrow">Rule-based engine</p>
            <h1>Recommendations</h1>
        </div>
        <nav class="ss-segmented" aria-label="Filter by recommendation">
            <a href="${ctx}/recommendations" class="${empty type ? 'is-active' : ''}">All ${total}</a>
            <c:forEach var="t" items="${types}">
                <a href="${ctx}/recommendations?type=${t}" class="${type == t ? 'is-active' : ''}">${t == 'INSUFFICIENT_DATA' ? 'Insufficient' : t} ${counts.get(t)}</a>
            </c:forEach>
        </nav>
    </div>

    <p class="ss-disclaimer mb-4">
        Recommendations are generated by fixed technical rules from stored price data. They are educational
        information, not personalised financial advice, and they do not guarantee any return.
    </p>

    <c:if test="${empty recommendations}"><div class="ss-card ss-empty">No recommendations in this category.</div></c:if>

    <div class="row g-3 mb-5">
        <c:forEach var="r" items="${recommendations}">
            <div class="col-md-6 col-xl-4"><ss:recCard r="${r}" allReasons="true"/></div>
        </c:forEach>
    </div>

    <section class="ss-card" id="methodology">
        <h2>How the score works</h2>
        <p class="ss-muted">
            Each enabled rule looks at one indicator and gives a signal of <strong>+1</strong> (bullish),
            <strong>-1</strong> (bearish) or <strong>0</strong> (neutral). The signal is multiplied by the rule's weight,
            and the score is the sum. A stock needs at least 60 stored daily bars; with fewer the engine shows
            "Insufficient data" instead of guessing.
        </p>
        <div class="table-responsive">
            <table class="table ss-table">
                <thead>
                    <tr><th scope="col">Rule</th><th scope="col">What it checks</th><th scope="col" class="num text-end">Weight</th><th scope="col">Status</th></tr>
                </thead>
                <tbody>
                    <c:forEach var="rule" items="${rules}">
                        <tr>
                            <td class="fw-semibold text-nowrap"><c:out value="${rule.name}"/></td>
                            <td class="ss-muted small"><c:out value="${rule.description}"/>
                                <c:if test="${not empty rule.paramLow or not empty rule.paramHigh}">
                                    <span class="ss-faint">(low ${rule.paramLowText}, high ${rule.paramHighText})</span>
                                </c:if>
                            </td>
                            <td class="num text-end">${rule.ruleKey == 'DECISION' ? '-' : rule.weightText}</td>
                            <td><span class="small ${rule.enabled ? 'up' : 'ss-faint'}">${rule.enabled ? 'Enabled' : 'Disabled'}</span></td>
                        </tr>
                    </c:forEach>
                </tbody>
            </table>
        </div>
        <p class="small ss-faint mb-0">Weights and thresholds are maintained by the administrator. The full methodology is in docs/recommendation-methodology.md.</p>
    </section>
</ss:page>
